# Optional: choose a different free local faster-whisper model.
# base.en is downloaded once and then reused from backend/.cache.
LOCAL_WHISPER_MODEL=base.en
MONGODB_URI=mongodb+srv://*************:**********@cluster0.sl9lahg.mongodb.net/?appName=Cluster0
# Comma-separated Vercel origins allowed to upload videos directly to Render.
FRONTEND_ORIGIN=https://ai-recruitment-platform-kappa.vercel.app
# Free Groq-powered mock and company interview questions. Keep the key server-side.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
COMPANY_INTERVIEW_MAX_QUESTIONS=5
